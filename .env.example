NODE_ENV=development
PORT=4000

# MySQL (format Prisma)
DATABASE_URL="mysql://user:password@host:3306/malalaspace"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Stripe (Phase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stockage S3-compatible (Phase 1.5)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
